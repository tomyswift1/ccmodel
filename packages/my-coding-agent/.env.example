# Never commit real credentials. Copy this file to .env (already gitignored).
AGENT_MODEL=<your-model>
AGENT_API_KEY=<your-api-key>

# Optional OpenAI-compatible gateway:
# AGENT_BASE_URL=https://example.com/v1

# Reliability controls (provider SDK transport layer):
AGENT_TIMEOUT=30
AGENT_MAX_RETRIES=3
